# JHONNY ELITE V3 - example only. Copy to .env (the Windows launcher creates it).
# Never share .env or paste your keys into chat.
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Safe first start: simulation; no automated bets or production signals.
SHADOW_MODE=true
WORKER_ENABLED=true
WORKER_SINGLE_PROCESS_ONLY=true
SCAN_INTERVAL_SECONDS=30
POST_GOAL_RESCAN_SECONDS=15
LIVE_BASE_CACHE_TTL_SECONDS=60
TRACKING_STATUS_TTL_SECONDS=90
MAX_PREMATCH_ENRICHMENTS_PER_CYCLE=1
API_ECONOMY_MODE=true

# Local PC + mobile access: the launcher generates a strong password in .env.
# Username on the browser prompt: jhonny
JHONNY_LAN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data persistence (retained inside the existing project structure)
JHONNY_DATA_DIR=app/v17/storage
RESULTS_TIMEZONE=America/La_Paz
RESULTS_CUTOFF_HOUR=0
RESULTS_CUTOFF_MINUTE=0
JHONNY_DEBUG_API_RAW=0
DEBUG=false

# Do not set VITE_API_URL for same-origin desktop/mobile access.
VITE_DASHBOARD_POLL_MS=15000

# Optional: provider plan constraints. 30s is the internal decision loop;
# the number of remote API calls still depends on cache, coverage, quota.
# The global LIVE feed has priority over cosmetic/details queries.
# Do not set 30-second requests on a free plan expecting 24/7 operation.
API_DAILY_RESERVE=300
