# ================================
# JHONNY ELITE 19 — ENV EXAMPLE
# Copy this file to .env locally. Never commit real keys.
# ================================
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Runtime
WORKER_ENABLED=true
WORKER_SINGLE_PROCESS_ONLY=true
SCAN_INTERVAL_SECONDS=30
LIVE_BASE_CACHE_TTL_SECONDS=15
POST_GOAL_RESCAN_SECONDS=15
GLOBAL_SENIOR_SCOPE=true
LIVE_DETAILS_BATCH_SIZE=20
LIVE_DETAILS_MAX_MATCHES=200
LIVE_DETAILS_CACHE_TTL_SECONDS=15

# Decision protocol
UNDER_MINUTE_MIN=75
CANDIDATE_PREMATCH_MIN_CONFIDENCE=58
PUBLISH_MIN_CONFIDENCE=68
STRONG_SIGNAL_CONFIDENCE=82
PREMIUM_SIGNAL_CONFIDENCE=88
CANDIDATE_ODDS_ENABLED=true
VALUE_REQUIRED_FOR_PREMIUM=true

# Market/value
CUOTA_MINIMA=1.50
CUOTA_MAXIMA=2.10
EDGE_MINIMO=0.05

# Frontend / API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vite frontend variable is configured separately:
# VITE_API_URL=http://127.0.0.1:8000

# Persistence / debug
DATABASE_URL=
JHONNY_DATA_DIR=app/v17/storage
JHONNY_DEBUG_API_RAW=0
JHONNY_DEBUG_API_RAW_DIR=debug_api_football
DEBUG=false

# Frontend (.env.local or platform environment)
VITE_API_URL=http://127.0.0.1:8000
VITE_DASHBOARD_POLL_MS=15000
