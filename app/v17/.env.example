# =====================================
# JHONNY ELITE 20 — MASTER PROTOCOL
# Copy to .env locally. Never commit real keys.
# =====================================
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Runtime / worker
WORKER_ENABLED=true
WORKER_SINGLE_PROCESS_ONLY=true
MASTER_PROTOCOL_ENABLED=true
SCAN_INTERVAL_SECONDS=30
POST_GOAL_RESCAN_SECONDS=15
SHADOW_MODE=false

# API economy
API_ECONOMY_MODE=true
API_DAILY_RESERVE=300
API_THROTTLE_USED_PERCENT=82
API_CRITICAL_USED_PERCENT=92
LIVE_BASE_CACHE_TTL_SECONDS=60
LIVE_DETAILS_BATCH_SIZE=20
LIVE_DETAILS_MAX_MATCHES=40
LIVE_DETAILS_CACHE_TTL_SECONDS=120
LIVE_FALLBACK_DEEP_MATCHES=2
LIVE_PLAYER_STATS_ENABLED=false

# Strict competition scope
GLOBAL_SENIOR_SCOPE=false
STRICT_COMPETITION_SCOPE=true
ENFORCE_ALLOWED_LEAGUE_IDS=false

# Master decision protocol
UNDER_MINUTE_MIN=60
UNDER_PREFERRED_MINUTE=65
CANDIDATE_PREMATCH_MIN_CONFIDENCE=72
PUBLISH_MIN_CONFIDENCE=84
STRONG_SIGNAL_CONFIDENCE=89
PREMIUM_SIGNAL_CONFIDENCE=94
MASTER_MIN_CONSENSUS=4
SIGNAL_MAX_SIMULTANEOUS=6
OBSERVATION_MIN_SCORE=45
MAX_LIVE_DATA_AGE_SECONDS=150
MAX_ODDS_AGE_SECONDS=180
REENTRY_COOLDOWN_SECONDS=300

# Candidate-only enrichment
MAX_PREMATCH_ENRICHMENTS_PER_CYCLE=1
MAX_PUBLISHED_SIGNALS_PER_CYCLE=6
CANDIDATE_ODDS_ENABLED=true
ODDS_CACHE_TTL_SECONDS=180
ODDS_MIN_CANDIDATE_SCORE=78
PREMATCH_ECONOMY_MODE=true
PREMATCH_MAX_NEW_PACKAGES_PER_HOUR=8
PREMATCH_PROVIDER_PREDICTION_ENABLED=false
PREMATCH_LEAGUE_SAMPLE_ENABLED=false

# Market / value
CUOTA_MINIMA=1.50
CUOTA_MAXIMA=2.10
EDGE_MINIMO=0.05
EDGE_MIN_PERCENT=4.0
VALUE_REQUIRED_FOR_PREMIUM=true

# Signal lifecycle reviews
SIGNAL_REVIEW_5_MIN=5
SIGNAL_REVIEW_10_MIN=10
SIGNAL_REVIEW_15_MIN=15
SIGNAL_REVIEW_20_MIN=20

# Bankroll guidance (analysis only; does not place bets)
BANKROLL_STAKE_MIN_PCT=1.0
BANKROLL_STAKE_MAX_PCT=3.0
BANKROLL_PREMIUM_MAX_PCT=5.0
BANKROLL_DAILY_LIMIT_PCT=10.0

# Frontend / API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence / debug
DATABASE_URL=
JHONNY_DATA_DIR=app/v17/storage
JHONNY_DEBUG_API_RAW=0
JHONNY_DEBUG_API_RAW_DIR=debug_api_football
DEBUG=false

# Frontend (.env.local or platform environment)
VITE_API_URL=http://127.0.0.1:8000
VITE_DASHBOARD_POLL_MS=15000
